            "description": "VM started successfully."
          }
        }
      }
    },

    "/StopVM": {
      "post": {
        "operationId": "StopVM",
        "summary": "Stop Azure VM",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "vm_name",
                  "resource_group"
                ],
                "properties": {
                  "vm_name": {
                    "type": "string"
                  },
                  "resource_group": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
