        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "vm_name",
                  "resource_group"
                ],
                "properties": {
                  "vm_name": {
                    "type": "string"
                  },
                  "resource_group": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "VM restarted successfully."
          }
        }
      }
    },

    "/IsolateAzureVM": {
      "post": {
        "operationId": "IsolateAzureVM",
        "summary": "Isolate VM",
        "description": "Blocks inbound and outbound traffic to a VM.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "vm_name",
                  "resource_group"
                ],
                "properties": {
                  "vm_name": {
                    "type": "string"
                  },
                  "resource_group": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "VM isolated successfully."
          }
        }
      }
    },

    "/RestoreVMConnectivity": {
      "post": {
        "operationId": "RestoreVMConnectivity",
        "summary": "Restore VM Connectivity",
        "description": "Removes isolation controls from a VM.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "vm_name",
                  "resource_group"
                ],
                "properties": {
                  "vm_name": {
                    "type": "string"
                  },
                  "resource_group": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connectivity restored successfully."
          }
        }
      }
    }
  },

  "components": {
    "securitySchemes": {
      "FunctionKey": {
        "type": "apiKey",
